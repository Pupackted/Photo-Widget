    "Deleting a widget deletes its photos from the app. Deleting the app removes everything it stored.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus widget akan menghapus fotonya dari app. Menghapus app akan menghapus semua yang disimpannya."
          }
        }
      }
    },
