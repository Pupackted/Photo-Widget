            "state": "translated",
            "value": "Widget diperbarui"
          }
        }
      }
    },
    "Widgets also work in StandBy and on iPad.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget juga berfungsi di StandBy dan iPad."
          }
        }
      }
    },
    "Write a caption": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis keterangan"
          }
        }
      }
    },
    "You can also add “Shuffle Photos” to Control Center, or ask Siri to “Shuffle Framed”.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda juga bisa menambahkan “Acak Foto” ke Pusat Kontrol, atau meminta Siri untuk “Shuffle Framed”."
          }
        }
      }
    },
    "You can also ask Siri to “Shuffle Framed”.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda juga bisa meminta Siri untuk “Shuffle Framed”."
          }
        }
      }
    },
    "Your favorite moments, right on your Home Screen.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Momen favorit Anda, langsung di Layar Utama."
          }
        }
      }
    },
    "Your favorite photos, beautifully framed.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto favorit Anda, terbingkai indah."
          }
        }
      }
    },
    "Your photos never leave your device.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto Anda tidak pernah keluar dari perangkat."
          }
        }
      }
    },
    "Your photos stay on this device. Nothing is uploaded, ever.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto Anda tetap di perangkat ini. Tidak ada yang diunggah, selamanya."
          }
        }
      }
    },
    "Your photos stay on your device": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto Anda tetap di perangkat Anda"
          }
        }
      }
    },
