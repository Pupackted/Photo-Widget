    "%lld of %lld photos couldn’t be loaded. If they’re stored in iCloud, check your connection and try adding them again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld photos couldn’t be loaded. If they’re stored in iCloud, check your connection and try adding them again."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld dari %2$lld foto tidak dapat dimuat. Jika foto tersimpan di iCloud, periksa koneksi Anda lalu coba tambahkan lagi."
          }
        }
      }
    },
